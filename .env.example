# Used by docker-compose.yml when running the full stack with `docker compose up`.
# Copy to `.env` in this same folder and adjust before deploying anywhere real.

# PostgreSQL
POSTGRES_DB=jobwatch
POSTGRES_USER=jobwatch
POSTGRES_PASSWORD=change-me
# Host port mapping (change if 5432 is already used by another app on the VPS)
POSTGRES_HOST_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# API (dev compose only; prod keeps the API off the public host network)
API_HOST_PORT=3000
EXTRACTOR_HOST_PORT=8100

# Production reverse-proxy port is hardcoded in docker-compose.prod.yml:
# 127.0.0.1:18083 (host nginx → jobwatch.maselcorp.com.br). Do not publish 80/443.

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# Frontend
# In production behind the same domain as the SPA, use the public origin
# (e.g. https://jobwatch.example.com) so cookies/CORS stay consistent.
CORS_ORIGIN=http://localhost:5173

# Monitoring
JOB_SOURCE=amazon
MONITORING_CONCURRENCY=3
WAREHOUSE_EXTRACTOR_URL=http://warehouse-extractor:8100

# WhatsApp (Cloud API — token permanente + Phone Number ID do painel Meta)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Parâmetros do corpo do template, se não for hello_world: title,message,url
WHATSAPP_TEMPLATE_BODY_PARAMS=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JobWatch <no-reply@jobwatch.local>"
